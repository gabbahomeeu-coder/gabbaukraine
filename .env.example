# ─────────────────────────────────────────────────────────────
# Bu dosya örnektir. Gerçek değerler .env.local içine yazılır.
# .env.local git'e girmez.
# ─────────────────────────────────────────────────────────────

# ── Veritabanı ──
# Supabase > Project Settings > Database > Connection string (URI)
# Migration için doğrudan bağlantı (port 5432)
DATABASE_URL="postgresql://postgres:SIFRE@db.PROJE.supabase.co:5432/postgres"

# ── Katalog kaynağı (KAT-05) ──
CATALOG_API_URL=
CATALOG_API_KEY=

# ── Ölçüm (OLC) ──
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=

# ── Site ──
NEXT_PUBLIC_SITE_URL=https://www.gabbaukraine.com

# ── Telegram (TLG) — ileride ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# ── Ödeme (SIP-02) — ileride, sağlayıcı seçilince ──
PAYMENT_PROVIDER=
PAYMENT_MERCHANT_ID=
PAYMENT_SECRET_KEY=

# ── Kargo (SIP-03) — ileride ──
NOVA_POSHTA_API_KEY=
