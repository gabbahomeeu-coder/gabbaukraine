// ══════════════════════════════════════════════════════════════════
// GABBA Ukraine — veritabanı şeması
//
// Faz 1 kapsamı: DIL (diller) · KAT (katalog) · MOD (modül yönetimi)
// YON (yönetim) ve olay omurgası.
// Diğer modüller kendi fazlarında eklenir; her ekleme kılavuza yazılır.
//
// Kurallar:
//  - Para birimi alanları Decimal, asla Float
//  - Dış kaynaktan gelen alanlar `externalId` ile eşlenir
//  - Bizim yazdığımız alanlar senkronda EZİLMEZ (isFeatured, sortOrder,
//    çeviriler, kumaş eşleşmeleri)
// ══════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: bağlantı adresi prisma.config.ts içinde
datasource db {
  provider = "postgresql"
}

// ══════════════════════════════ DIL ══════════════════════════════

model Locale {
  code      String  @id // "uk", "ru", "en"
  name      String
  isDefault Boolean @default(false)
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  @@map("locales")
}

// ══════════════════════════════ KAT ══════════════════════════════

/// KAT-07 · Tedarikçi. Dış sunucudan gelir.
model Supplier {
  id           String    @id @default(cuid())
  externalId   String?   @unique
  name         String
  contact      String?
  leadTimeDays Int? // varsayılan tedarik süresi
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  products     Product[]

  @@map("suppliers")
}

/// KAT-02 · Koleksiyon. Ad dış sunucudan, düzen ve metin bizden.
model Collection {
  id           String                  @id @default(cuid())
  externalId   String?                 @unique
  slug         String                  @unique
  brand        String                  @default("gabba") // gabba | monett | isil
  /// kapak görseli — geniş ekran
  image        String?
  /// kapak görseli — telefon (dikey). Boşsa `image` kullanılır
  mobileImage  String?
  /// yerel — senkron ezmez
  sortOrder    Int                     @default(0)
  isFeatured   Boolean                 @default(false)
  isActive     Boolean                 @default(true)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  translations CollectionTranslation[]
  products     Product[]
  media        Media[]

  @@map("collections")
}

model CollectionTranslation {
  id           String     @id @default(cuid())
  collectionId String
  locale       String
  name         String
  description  String?
  seoTitle     String?
  seoDesc      String?
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, locale])
  @@map("collection_translations")
}

/// KAT-02 · Kategori (kanepe, masa, sandalye…). Tamamen bizde.
model Category {
  id           String                @id @default(cuid())
  slug         String                @unique
  image        String?
  sortOrder    Int                   @default(0)
  isActive     Boolean               @default(true)
  translations CategoryTranslation[]
  products     Product[]

  @@map("categories")
}

model CategoryTranslation {
  id         String   @id @default(cuid())
  categoryId String
  locale     String
  name       String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@map("category_translations")
}

/// KAT-01 · Ürün. Dış sunucu tek kayıt verir: fiyat, stok, ölçü.
/// Ölçü seçenekleri Variant'ta, kumaş seçenekleri Fabric'te tutulur.
model Product {
  id         String  @id @default(cuid())
  externalId String? @unique
  slug       String  @unique

  collectionId String?
  categoryId   String?
  supplierId   String?

  /// dış sunucudan — senkron günceller
  basePrice Decimal  @db.Decimal(12, 2)
  currency  String   @default("UAH")
  /// KAT-09 ölçü asistanı için; varyant yoksa ürünün kendi ölçüsü
  widthCm   Decimal? @db.Decimal(8, 1)
  depthCm   Decimal? @db.Decimal(8, 1)
  heightCm  Decimal? @db.Decimal(8, 1)
  /// Kaynaktaki ölçü metni olduğu gibi. Sayısal alanların taşıyamadığı
  /// bilgiyi içerir: ikinci parça ("220/49/98 & 102/6/102"), oturma
  /// yüksekliği ("58/60/85 в.пос.45"). Müşteriye ham gösterilmez.
  dimensionsRaw String?
  /// tedarikçi maliyeti — RPR-06 kârlılık raporu için
  costPrice Decimal? @db.Decimal(12, 2)

  /// yerel — senkron EZMEZ
  isFeatured Boolean @default(false)
  sortOrder  Int     @default(0)
  /// SİTEDE yayında mı — bizim kararımız, senkron dokunmaz
  isActive   Boolean @default(false)
  /// KAYNAKTA satışta mı — senkron günceller. Site ikisini de arar
  sourceActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  collection   Collection?          @relation(fields: [collectionId], references: [id])
  category     Category?            @relation(fields: [categoryId], references: [id])
  supplier     Supplier?            @relation(fields: [supplierId], references: [id])
  translations ProductTranslation[]
  variants     Variant[]
  fabrics      ProductFabric[]
  media        Media[]
  stockMoves   StockMove[]

  @@index([collectionId])
  @@index([categoryId])
  @@map("products")
}

model ProductTranslation {
  id        String  @id @default(cuid())
  productId String
  locale    String
  name      String
  description String?
  materials   String?
  careInfo    String?
  seoTitle    String?
  seoDesc     String?
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  @@map("product_translations")
}

/// KAT-08 · Ölçü varyantı. "Madrid Kanepe 240 cm" gibi.
/// Kendi fiyatı ve kendi stoğu vardır — kumaştan bağımsızdır.
/// Ürünün tek ölçüsü varsa varyant oluşturulmaz, basePrice kullanılır.
model Variant {
  id         String  @id @default(cuid())
  productId  String
  externalId String? @unique
  sku        String? @unique
  /// müşteriye görünen etiket: "240 cm", "Köşe · sol"
  label      String

  widthCm  Decimal? @db.Decimal(8, 1)
  depthCm  Decimal? @db.Decimal(8, 1)
  heightCm Decimal? @db.Decimal(8, 1)

  /// bu ölçünün fiyatı — ürünün basePrice'ının yerine geçer
  price     Decimal  @db.Decimal(12, 2)
  costPrice Decimal? @db.Decimal(12, 2)

  isDefault Boolean  @default(false)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockMoves StockMove[]

  @@index([productId])
  @@map("variants")
}

/// KAT-08 · Kumaş grubu: Bukle · Kadife · Deri · Keten
model FabricGroup {
  id           String                  @id @default(cuid())
  code         String                  @unique
  sortOrder    Int                     @default(0)
  isActive     Boolean                 @default(true)
  translations FabricGroupTranslation[]
  fabrics      Fabric[]

  @@map("fabric_groups")
}

model FabricGroupTranslation {
  id      String      @id @default(cuid())
  groupId String
  locale  String
  name    String
  group   FabricGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, locale])
  @@map("fabric_group_translations")
}

/// KAT-08 · Kumaş. Tamamen bizde tanımlanır — dış sunucu vermiyor.
/// Fiyata fark ekler, teslim süresini etkileyebilir.
model Fabric {
  id      String @id @default(cuid())
  code    String @unique
  groupId String

  /// doku fotoğrafı — kare, yakın çekim
  swatchUrl String?

  /// taban fiyata eklenen tutar; çarpan gerekiyorsa priceMultiplier
  priceDelta      Decimal? @db.Decimal(12, 2)
  priceMultiplier Decimal? @db.Decimal(5, 3)
  /// bu kumaş seçilirse teslim süresine eklenen gün
  extraLeadDays   Int?     @default(0)

  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group        FabricGroup         @relation(fields: [groupId], references: [id])
  translations FabricTranslation[]
  products     ProductFabric[]

  @@index([groupId])
  @@map("fabrics")
}

model FabricTranslation {
  id       String @id @default(cuid())
  fabricId String
  locale   String
  name     String
  /// "%100 polyester, 45.000 Martindale" gibi
  composition String?
  fabric   Fabric @relation(fields: [fabricId], references: [id], onDelete: Cascade)

  @@unique([fabricId, locale])
  @@map("fabric_translations")
}

/// Hangi kumaş hangi üründe kullanılabilir — panelde işaretlenir
model ProductFabric {
  productId String
  fabricId  String
  isDefault Boolean @default(false)
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  fabric  Fabric  @relation(fields: [fabricId], references: [id], onDelete: Cascade)

  @@id([productId, fabricId])
  @@map("product_fabrics")
}

/// KAT-04 · Medya. Görseller dış sunucuda barındırılabilir.
model Media {
  id         String   @id @default(cuid())
  /// ürün görseli (dekupe) — koleksiyon görsellerinde boş
  productId  String?
  /// koleksiyon ortam fotoğrafı — ürün görsellerinde boş
  collectionId String?
  /// kaynaktaki kimlik; yoksa adresten türetilir
  externalId String?  @unique
  url        String
  alt        String?
  type       String   @default("image") // image | video
  /// cutout (beyaz zemin) | catalog (ortam) | null (bilinmiyor)
  kind       String?
  /// piksel boyutları — yatay/dikey ayrımı buradan yapılıyor
  width      Int?
  height     Int?
  isExternal Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  product    Product?    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection Collection? @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([collectionId])
  @@map("media")
}

/// KAT-03 · Stok hareketle tutulur, sayı olarak değil — geçmiş kaybolmaz.
/// Güncel adet = hareketlerin toplamı.
model StockMove {
  id        String   @id @default(cuid())
  productId String
  variantId String?
  delta     Int // + giriş, − çıkış
  reason    StockReason
  /// senkron kaynağı, sipariş no vb.
  reference String?
  note      String?
  createdAt DateTime @default(now())

  product Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant Variant? @relation(fields: [variantId], references: [id])

  @@index([productId])
  @@index([variantId])
  @@map("stock_moves")
}

enum StockReason {
  SENKRON // dış sunucudan gelen düzeltme
  SIPARIS // satış
  IPTAL // sipariş iptali
  IADE
  SAYIM // elle düzeltme
}

/// KAT-05 · Dış katalog kaynağı
model ExternalSource {
  id         String    @id @default(cuid())
  name       String
  baseUrl    String
  authType   String    @default("bearer")
  isActive   Boolean   @default(true)
  lastSyncAt DateTime?
  syncLogs   SyncLog[]

  @@map("external_sources")
}

/// KAT-05 · Her senkronun kaydı. Bekçi uyarıları burada görünür.
model SyncLog {
  id           String     @id @default(cuid())
  sourceId     String
  startedAt    DateTime   @default(now())
  finishedAt   DateTime?
  status       SyncStatus @default(CALISIYOR)
  itemsRead    Int        @default(0)
  itemsWritten Int        @default(0)
  itemsSkipped Int        @default(0)
  /// bekçinin reddettiği kayıtlar ve sebepleri
  warnings     Json?
  error        String?

  source ExternalSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@map("sync_logs")
}

enum SyncStatus {
  CALISIYOR
  TAMAM
  UYARILI // tamamlandı ama bazı kayıtlar atlandı
  HATA
}

// ══════════════════════════════ MOD ══════════════════════════════

/// MOD-01 · Modül kayıt defteri. Tanım kodda, durum burada.
model Module {
  code       String      @id // "KAT"
  name       String
  layer      ModuleLayer
  isEnabled  Boolean     @default(true)
  isCore     Boolean     @default(false) // çekirdek modül kapatılamaz
  sortOrder  Int         @default(0)
  updatedAt  DateTime    @updatedAt

  subModules SubModule[]
  settings   ModuleSetting[]
  health     ModuleHealth[]
  changelog  ChangelogEntry[]

  @@map("modules")
}

enum ModuleLayer {
  PLATFORM
  IS
}

/// MOD-01 · Alt modül. Künye biçimi: KAT-03
model SubModule {
  code           String  @id // "KAT-03"
  moduleCode     String
  name           String
  responsibility String?
  isEnabled      Boolean @default(true)
  sortOrder      Int     @default(0)

  module    Module           @relation(fields: [moduleCode], references: [code], onDelete: Cascade)
  changelog ChangelogEntry[]

  @@index([moduleCode])
  @@map("sub_modules")
}

/// MOD-03 · Modül ayarları. Panel formu bu kayıtlardan üretilir.
model ModuleSetting {
  id         String   @id @default(cuid())
  moduleCode String
  key        String
  value      Json
  updatedAt  DateTime @updatedAt
  updatedBy  String?

  module Module @relation(fields: [moduleCode], references: [code], onDelete: Cascade)

  @@unique([moduleCode, key])
  @@map("module_settings")
}

/// MOD-04 · Sağlık kontrolü sonucu
model ModuleHealth {
  id         String       @id @default(cuid())
  moduleCode String
  checkedAt  DateTime     @default(now())
  status     HealthStatus
  message    String?

  module Module @relation(fields: [moduleCode], references: [code], onDelete: Cascade)

  @@index([moduleCode, checkedAt])
  @@map("module_health")
}

enum HealthStatus {
  SAGLIKLI
  UYARI
  ARIZALI
  KAPALI
}

/// MOD-05 · KILAVUZ. Her düzeltme ve güncelleme buraya yazılır.
/// Alt modüle yazılan kayıt, üst modülün kılavuzunda da görünür
/// (moduleCode her zaman dolu olduğu için tek sorguyla listelenir).
model ChangelogEntry {
  id            String     @id @default(cuid())
  moduleCode    String
  subModuleCode String?
  type          ChangeType
  title         String
  /// önceki durum
  before        String
  /// sonraki durum
  after         String
  reason        String?
  author        String
  createdAt     DateTime   @default(now())

  module    Module     @relation(fields: [moduleCode], references: [code], onDelete: Cascade)
  subModule SubModule? @relation(fields: [subModuleCode], references: [code], onDelete: SetNull)

  @@index([moduleCode, createdAt])
  @@index([subModuleCode, createdAt])
  @@map("changelog_entries")
}

enum ChangeType {
  EKLEME
  DUZELTME
  DEGISIKLIK
  KALDIRMA
}

// ══════════════════════════════ YON ══════════════════════════════

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  roleCode     String    @default("admin")
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())

  role      Role       @relation(fields: [roleCode], references: [code])
  auditLogs AuditLog[]

  @@map("admin_users")
}

model Role {
  code        String      @id // "admin", "satis", "icerik"
  name        String
  /// { "KAT": ["oku","yaz"], "SIP": ["oku"] }
  permissions Json
  users       AdminUser[]

  @@map("roles")
}

/// YON-03 · Her yönetici işlemi iz bırakır
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String // "urun.guncelle"
  entity    String // "Product"
  entityId  String?
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  actor AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ═══════════════════════════ OMURGA ═══════════════════════════

/// Atardamarların taşıyıcısı. Modüller birbirini doğrudan çağırmaz,
/// buraya olay yazar; işleyici sırayla dağıtır.
model OutboxEvent {
  id      String @id @default(cuid())
  /// "odeme.basarili"
  name    String
  payload Json
  /// yayınlayan modül künyesi
  source  String

  status      EventStatus @default(BEKLIYOR)
  attempts    Int         @default(0)
  /// bekçi tekrar kontrolü — aynı anahtar iki kez işlenmez
  dedupeKey   String?     @unique
  availableAt DateTime    @default(now())
  processedAt DateTime?
  lastError   String?
  createdAt   DateTime    @default(now())

  @@index([status, availableAt])
  @@index([name, createdAt])
  @@map("outbox_events")
}

enum EventStatus {
  BEKLIYOR
  ISLENIYOR
  TAMAM
  HATA
}

/// Bekçinin reddettiği olaylar. Kaybolmaz, panelde görünür,
/// düzeltilip yeniden kuyruğa alınabilir.
model EventQuarantine {
  id         String    @id @default(cuid())
  eventName  String
  payload    Json
  /// hangi kontrol düştü: sekil | tekrar | yetki
  guardCheck String
  reason     String
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([createdAt])
  @@map("event_quarantine")
}
